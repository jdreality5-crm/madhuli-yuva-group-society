    "bcryptjs": "^3.0.3",
    "jose": "^6.1.0",
    "next": "^16.3.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.4.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-rsc": "^0.5.34",
    "prisma": "^6.19.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
