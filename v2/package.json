  "scripts": {
    "dev": "next dev",
    "dev:vinext": "vinext dev",
    "build": "prisma migrate deploy && next build",
    "build:vinext": "vinext build",
    "deploy:cloudflare": "npx @vinext/cloudflare deploy",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:generate:edge": "prisma generate --no-engine",
