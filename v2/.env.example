# PostgreSQL connection string from the NEW Supabase project's Connect > Prisma / URI settings
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Long random production secret. Never commit the real value.
JWT_SECRET="replace-with-a-long-random-production-secret"

# Deployment-level society context. Keep the current value for this single-society deployment.
# Change only when intentionally deploying this application against a different society.
DEFAULT_SOCIETY_ID="demo-society-v2"

# Supabase server-side Storage configuration. Never expose or commit the service-role key.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"
SUPABASE_STORAGE_BUCKET="society-files"

# Email OTP delivery (server-side only)
EMAIL_PROVIDER="gmail"
GMAIL_CLIENT_ID="replace-with-google-oauth-client-id"
GMAIL_CLIENT_SECRET="replace-with-google-oauth-client-secret"
GMAIL_REFRESH_TOKEN="replace-with-google-oauth-refresh-token"
GMAIL_SENDER_EMAIL="society-verification@example.com"

# Resend can remain configured as an alternate provider when needed.
RESEND_API_KEY="re_..."
EMAIL_FROM="Society Admin <noreply@your-verified-domain.example>"

# Optional public base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
